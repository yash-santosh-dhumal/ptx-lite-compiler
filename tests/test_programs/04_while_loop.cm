// =============================================================================
// 04_while_loop.cm — While loop iteration, counters, accumulation
// =============================================================================
// Expected outputs:
// 1
// 2
// 3
// 4
// 5
// 15     (Accumulated sum 1+2+3+4+5)
// =============================================================================

int i = 1;
int sum = 0;

while (i <= 5) {
    print(i);
    sum = sum + i;
    i = i + 1;
}

print(sum);
