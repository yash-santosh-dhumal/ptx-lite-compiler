// =============================================================================
// 02_variables.cm — Declarations, reassignments, expressions with variables
// =============================================================================
// Expected outputs:
// 10
// 25
// 35
// 70
// =============================================================================

int x = 10;
print(x);

int y = 25;
print(y);

int sum = x + y;
print(sum);

// Re-assignment
x = sum * 2;
print(x);
