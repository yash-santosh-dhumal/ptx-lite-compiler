// =============================================================================
// 01_arithmetic.cm — Arithmetic operator precedence, associativity & unary ops
// =============================================================================
// Expected outputs:
// 14       (2 + 3 * 4 = 2 + 12 = 14)
// 20       ((2 + 3) * 4 = 5 * 4 = 20)
// 10       (100 / 5 / 2 = 20 / 2 = 10; left-associative)
// 1        (17 % 4 = 1)
// -5       (unary negation: -5)
// 15       (20 + -5 = 15)
// 0        (!1 = 0)
// 1        (!0 = 1)
// =============================================================================

int a = 2 + 3 * 4;
print(a);

int b = (2 + 3) * 4;
print(b);

int c = 100 / 5 / 2;
print(c);

int d = 17 % 4;
print(d);

int e = -5;
print(e);

int f = 20 + -5;
print(f);

int g = !1;
print(g);

int h = !0;
print(h);
